          "editorMode": "code",
          "expr": "(\n  clamp_min(\n    (sum(rate(tablets_DataShard_EngineHostRowUpdateBytes{database=\"$database\"}[$agg])) or vector(0))\n    + (sum(rate(tablets_DataShard_EngineHostRowEraseBytes{database=\"$database\"}[$agg])) or vector(0))\n    - 8 * (sum(rate(tablets_DataShard_EngineHostRowErases{database=\"$database\"}[$agg])) or vector(0)),\n    0\n  )\n  / clamp_min(\n    (sum(rate(tablets_DataShard_EngineHostRowUpdates{database=\"$database\"}[$agg])) or vector(0))\n    + (sum(rate(tablets_DataShard_EngineHostRowErases{database=\"$database\"}[$agg])) or vector(0)),\n    1e-12\n  )\n) and (\n  (sum(rate(tablets_DataShard_EngineHostRowUpdates{database=\"$database\"}[$agg])) or vector(0))\n  + (sum(rate(tablets_DataShard_EngineHostRowErases{database=\"$database\"}[$agg])) or vector(0))\n  > 0\n)",
          "legendFormat": "bytes per record",
          "refId": "A"
        }
      ],
      "title": "Cell bytes per record",
      "type": "stat"
    },
