# Скопируйте в env.local и подставьте свои значения:
#   cp env.example env.local
#   source env.local
#
# Подробности: connect.md

export PGHOST=db.example.com
export PGPORT=5432
export PGUSER=appuser
export PGDATABASE=appdb
export PGPASSWORD='secret'
export PGSSLMODE=disable
# export PGAPPNAME=ydb-snippets-pg-examples
